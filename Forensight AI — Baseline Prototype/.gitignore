# Dependencies
node_modules/
frontend/node_modules/

# Build outputs
dist/
frontend/dist/
dist-ssr/
*.local

# Python cache & test artifacts
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/
backend/**/.pytest_cache/

# Environment configurations
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

